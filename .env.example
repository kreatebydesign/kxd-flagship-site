# Environment variable placeholders — NEVER put real secrets in this file.
#
# Database (local disposable only for lifecycle QA):
# DATABASE_URI=postgres://USER:PASSWORD@127.0.0.1:5432/kxd_audit_report_review
#
# --- Stripe TEST MODE (commercial lifecycle) ---
# Prefer dedicated test variables so live keys cannot be selected accidentally.
# STRIPE_SECRET_KEY_TEST=sk_test_...
# STRIPE_WEBHOOK_SECRET_TEST=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_TEST=pk_test_...
#
# Fallback (only if dedicated test vars unset). Must still be sk_test_ / pk_test_ / whsec_.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
#
# Do NOT set live keys for commercial lifecycle work:
# STRIPE_SECRET_KEY_LIVE / STRIPE_LIVE_SECRET_KEY — unused by commercial lifecycle; live prefixes fail closed.
#
# Commercial lifecycle webhook (Stripe CLI example — local only):
# stripe listen --forward-to localhost:3000/api/stripe/commercial-lifecycle-webhook
# Then set STRIPE_WEBHOOK_SECRET_TEST to the CLI signing secret (never commit it).
#
# Legacy / plaintext token fallback (local QA only — never enable in production):
# KXD_ALLOW_LEGACY_PLAINTEXT_TOKENS=1
